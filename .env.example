# Smart Wardrobe Mobile Environment Configuration Template
API_BASE_URL=
API_BASE_URL_ANDROID=
CLOUDINARY_CLOUD_NAME=
APP_ENV=development
DEFAULT_WEB_PORT=

# Google Sign-In client IDs (Web/Server client id) — chọn theo môi trường API
# GOOGLE_CLIENT_ID      -> localhost:8080 (dev)
# GOOGLE_CLIENT_ID_PROD -> https://api.closy.hycat.online
# GOOGLE_CLIENT_ID_V2   -> https://api-v2.closy.hycat.online
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_PROD=
GOOGLE_CLIENT_ID_V2=

# run
flutter run -d chrome --web-port 8081
